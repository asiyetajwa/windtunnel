{
  "name": "windtunnel",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Wind Tunnel: a test track for robot policies with no robot. Nemotron reads the failures, proposes the fix, and the simulator decides what stays.",
  "workspaces": [
    "packages/nebius-core"
  ],
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "start": "npm run build && tsx --env-file-if-exists=.env src/server/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p . --noEmit",
    "rounds": "tsx --env-file-if-exists=.env scripts/rounds.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
